{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "swap: run",
      "type": "debugpy",
      "request": "launch",
      "module": "swap",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "run",
        "--folder-a",
        "${input:folderA}",
        "--folder-b",
        "${input:folderB}",
        "--work-dir",
        "${input:workDir}",
        "--chunk-size",
        "${input:chunkSize}",
        "--safety-margin",
        "${input:safetyMargin}",
        "--backend",
        "${input:backend}",
        "--workers",
        "${input:workers}"
      ]
    },
    {
      "name": "swap: resume",
      "type": "debugpy",
      "request": "launch",
      "module": "swap",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "resume",
        "--work-dir",
        "${input:workDir}"
      ]
    },
    {
      "name": "swap: status",
      "type": "debugpy",
      "request": "launch",
      "module": "swap",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "status",
        "--work-dir",
        "${input:workDir}"
      ]
    },
    {
      "name": "tests: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pytest.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "-q",
        "${file}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "folderA",
      "type": "promptString",
      "description": "Path to folder A",
      "default": "F:\\wer"
    },
    {
      "id": "folderB",
      "type": "promptString",
      "description": "Path to folder B",
      "default": "G:\\qwe"
    },
    {
      "id": "workDir",
      "type": "promptString",
      "description": "Path to the swap work directory",
      "default": "I:\\.swap_work"
    },
    {
      "id": "chunkSize",
      "type": "promptString",
      "description": "Chunk size for sparse transfer mode",
      "default": "64MB"
    },
    {
      "id": "safetyMargin",
      "type": "promptString",
      "description": "Safety margin to keep free on each drive",
      "default": "64MB"
    },
    {
      "id": "backend",
      "type": "pickString",
      "description": "Transfer backend",
      "options": [
        "winapi",
        "python"
      ],
      "default": "winapi"
    },
    {
      "id": "workers",
      "type": "promptString",
      "description": "Worker count",
      "default": "8"
    }
  ]
}
